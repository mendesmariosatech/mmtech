{
  "providers": ["node"],
  "phases": {
    "setup": {
      "nixPkgs": ["...", "nodejs_22"]
    },
    "install": {
      "cmds": ["yarn install --frozen-lockfile"]
    },
    "build": {
      "cmds": ["yarn --cwd apps/docs build"]
    }
  },
  "start": {
    "cmd": "cd apps/docs && yarn start"
  }
}
